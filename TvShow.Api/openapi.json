{
  "openapi": "3.1.1",
  "info": {
    "title": "TvShow.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/tvshows": {
      "get": {
        "tags": [
          "TvShows"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TvShowViewModel"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TvShowViewModel": {
        "required": [
          "id",
          "name",
          "releasedAt",
          "seasons",
          "episodes"
        ],
        "type": "object",
        "properties": {
          "id": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "releasedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "seasons": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "episodes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "TvShows"
    }
  ]
}